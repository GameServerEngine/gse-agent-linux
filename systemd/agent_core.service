# GSE Linux Agent systemd service

[Unit]
Description=Gameserver Engine Linux Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={AGENT_USER}
Group={AGENT_USER}
WorkingDirectory={AGENT_PATH}
ExecStart={AGENT_RUN_SCRIPT} -pidfile {AGENT_PID_FILE}
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
