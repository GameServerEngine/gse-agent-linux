#!/bin/bash

# Generic Init script if we can't find what kind of Linux we're on

agent_dir=AGENT_DIR
agent_user=AGENT_USER

# Start function.
start() {
    echo "Starting GSE Agent..."
    cd $agent_dir
    su -c "screen -d -m -t agent_core -c screen_config -S agent_core ./agent_core_run -pidfile agent_core_run.pid" $agent_user &> $agent_dir/agent_core.svc &
    echo
}

# Stop function.
stop() {
    echo "Stopping GSE Agent..."
    kill `cat $agent_dir/agent_core_run.pid`
}

restart() {
    stop
    start
}

case $1 in
    start)
    start
    ;;
    stop)
    stop
    ;;
    restart)
    restart
    ;;
    *)
    echo "Usage: agent_core {start|stop|restart}"
    exit 1
    ;;
esac

exit 0;
