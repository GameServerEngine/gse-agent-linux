#!/usr/bin/env bash

set -euo pipefail

AGENTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT="${AGENTDIR}/gsp_agent.pl"
BASH_PREFS_CONF="${AGENTDIR}/Cfg/bash_prefs.cfg"
LOCK_FILE="${AGENTDIR}/gsp_agent_run.lock"
DEFAULT_PID_FILE="${AGENTDIR}/gsp_agent_run.pid"
STATE_FILE="${AGENTDIR}/gsp_agent_update_state.json"
REQUEST_FILE="${AGENTDIR}/gsp_agent_update_request.json"
UPDATE_LOG="${AGENTDIR}/gsp_agent_update.log"
REVISION_FILE="${AGENTDIR}/.gsp_agent_source_revision"
FAIL_MARKER="${AGENTDIR}/.gsp_agent_update_failed"
BACKUP_ARCHIVE="${AGENTDIR}/agent_restart_update_backup.tar.gz"
TIMEOUT=10
PID_FILE=""
UPDATE_APPLIED=0
ROLLBACK_AVAILABLE=0
UPDATE_VERSION_BEFORE=""
UPDATE_APPLIED_AT=0
UPDATE_FAILED_KEY=""
UPDATE_ID=""
UPDATE_REPO=""
UPDATE_BRANCH=""
UPDATE_SOURCE_PATH=""
agent_args=()

log() {
	printf '%s\n' "$*"
}

log_update() {
	printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$UPDATE_LOG"
}

json_escape() {
	printf '%s' "$1" | sed 's/[\\"]/ /g'
}

write_state() {
	local status="$1"
	local message="$2"
	local rollback="${3:-0}"
	local revision="${4:-}"
	local repo="${5:-$UPDATE_REPO}"
	local branch="${6:-$UPDATE_BRANCH}"
	local source_path="${7:-$UPDATE_SOURCE_PATH}"
	local update_id="${UPDATE_ID:-restart-$(date +%s)}"
	local version_before
	version_before="${UPDATE_VERSION_BEFORE:-$(cat "$REVISION_FILE" 2>/dev/null || true)}"
	mkdir -p "$(dirname "$STATE_FILE")"
	printf '{"status":"%s","message":"%s","update_id":"%s","log_path":"%s","state_path":"%s","request_path":"%s","rollback_performed":"%s","version_before":"%s","version_after":"%s","repo_url":"%s","branch":"%s","source_path":"%s","target_commit":"%s","current_commit":"%s"}\n' \
		"$status" "$(json_escape "$message")" "$(json_escape "$update_id")" "$UPDATE_LOG" "$STATE_FILE" "$REQUEST_FILE" "$rollback" "$version_before" "$revision" "$(json_escape "$repo")" "$(json_escape "$branch")" "$(json_escape "$source_path")" "$revision" "$(cat "$REVISION_FILE" 2>/dev/null || true)" > "$STATE_FILE"
}

request_field() {
	local key="$1"
	local default_value="${2:-}"
	[ -s "$REQUEST_FILE" ] || {
		printf '%s' "$default_value"
		return 0
	}
	perl -MJSON::PP -e '
		my ($file, $key, $default) = @ARGV;
		open my $fh, "<", $file or do { print $default; exit 0 };
		local $/;
		my $json = <$fh>;
		my $data = eval { decode_json($json) };
		if (ref($data) eq "HASH" && defined $data->{$key}) { print $data->{$key}; }
		else { print $default; }
	' "$REQUEST_FILE" "$key" "$default_value" 2>/dev/null
}

load_update_request() {
	[ -s "$REQUEST_FILE" ] || return 1
	UPDATE_ID="$(request_field update_id "")"
	UPDATE_REPO="$(request_field repo_url "")"
	UPDATE_BRANCH="$(request_field branch "unstable")"
	UPDATE_SOURCE_PATH="$(request_field source_path ".")"
	[ -n "$UPDATE_ID" ] || UPDATE_ID="restart-$(date +%s)"
	[ -n "$UPDATE_REPO" ] || return 1
	[[ "$UPDATE_REPO" =~ ^(https?://|ssh://|git@|/) && "$UPDATE_REPO" != *$'\n'* && "$UPDATE_REPO" != *$'\r'* ]] || return 1
	[[ "$UPDATE_BRANCH" =~ ^[A-Za-z0-9._/-]{1,128}$ ]] || return 1
	[[ "$UPDATE_SOURCE_PATH" =~ ^[A-Za-z0-9._/-]+$ && "$UPDATE_SOURCE_PATH" != *".."* ]] || return 1
	return 0
}

clear_update_request() {
	rm -f "$REQUEST_FILE" 2>/dev/null || true
}

read_pref() {
	local key="$1"
	local default_value="$2"
	local line value
	[ -f "$BASH_PREFS_CONF" ] || {
		printf '%s' "$default_value"
		return 0
	}
	line="$(grep -E "^[[:space:]]*${key}=" "$BASH_PREFS_CONF" | tail -n 1 || true)"
	[ -n "$line" ] || {
		printf '%s' "$default_value"
		return 0
	}
	value="${line#*=}"
	if [[ "$value" =~ ^\".*\"$ || "$value" =~ ^\'.*\'$ ]]; then
		value="${value:1:${#value}-2}"
	fi
	printf '%b' "$value"
}

config_value() {
	local key="$1"
	perl -I "$AGENTDIR" -MCfg::Config -e "print defined \$Cfg::Config{$key} ? \$Cfg::Config{$key} : ''" 2>/dev/null || true
}

validate_pid() {
	local pid="$1"
	[[ "$pid" =~ ^[0-9]+$ ]] || return 1
	kill -0 "$pid" >/dev/null 2>&1 || return 1
	return 0
}

ensure_port_available() {
	local listen_ip="$1"
	local listen_port="$2"
	[ -n "$listen_port" ] || return 0
	perl -MIO::Socket::INET -e '
		my ($host, $port) = @ARGV;
		$host = "0.0.0.0" if !defined($host) || $host eq "";
		my $sock = IO::Socket::INET->new(LocalAddr => $host, LocalPort => $port, Proto => "tcp", Listen => 1, ReuseAddr => 1);
		exit($sock ? 0 : 1);
	' "$listen_ip" "$listen_port" >/dev/null 2>&1 || {
		log "ERROR: configured agent port ${listen_ip}:${listen_port} is already in use. Refusing to start a duplicate agent."
		exit 1
	}
}

prepare_runtime() {
	mkdir -p "${AGENTDIR}/logs" "${AGENTDIR}/screenlogs" "${AGENTDIR}/tmp" "${AGENTDIR}/runtime_status" "${AGENTDIR}/events" "${AGENTDIR}/_gsp_content/hooks" "${AGENTDIR}/_gsp_content/generated" "${AGENTDIR}/_gsp_content/runtime"
	touch "${AGENTDIR}/_gsp_content/runtime/server_content.pids" 2>/dev/null || true
}

validate_config() {
	if [ "$(id -u)" -eq 0 ]; then
		log "ERROR: Do not run the GSE agent as root. Run it as the configured agent user." >&2
		exit 1
	fi
	if [ ! -f "${AGENTDIR}/Cfg/Config.pm" ]; then
		log "ERROR: Missing ${AGENTDIR}/Cfg/Config.pm. Run ./agent_conf.sh --guided." >&2
		exit 1
	fi
	if grep -Eq "CHANGE_ME_PANEL_AGENT_KEY|key[[:space:]]*=>[[:space:]]*''" "${AGENTDIR}/Cfg/Config.pm"; then
		log "ERROR: ${AGENTDIR}/Cfg/Config.pm still has a placeholder agent key." >&2
		exit 1
	fi
}

acquire_instance_lock() {
	exec 9>"$LOCK_FILE"
	if ! flock -n 9; then
		if [ -f "$DEFAULT_PID_FILE" ]; then
			local existing_pid
			existing_pid="$(cat "$DEFAULT_PID_FILE" 2>/dev/null || true)"
			if validate_pid "$existing_pid"; then
				log "ERROR: another GSE agent wrapper is already running with PID ${existing_pid}."
				exit 1
			fi
		fi
		log "ERROR: another GSE agent wrapper holds ${LOCK_FILE}."
		exit 1
	fi

	if [ -f "$DEFAULT_PID_FILE" ]; then
		local stale_pid
		stale_pid="$(cat "$DEFAULT_PID_FILE" 2>/dev/null || true)"
		validate_pid "$stale_pid" || rm -f "$DEFAULT_PID_FILE"
	fi
}

parse_args() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-pidfile)
				PID_FILE="${2:-}"
				shift 2
				;;
			*)
				agent_args+=("$1")
				shift
				;;
		esac
	done
	[ -n "$PID_FILE" ] || PID_FILE="$DEFAULT_PID_FILE"
}

cleanup_pid() {
	if [ -n "$PID_FILE" ] && [ -f "$PID_FILE" ] && [ "$(cat "$PID_FILE" 2>/dev/null || true)" = "$$" ]; then
		rm -f "$PID_FILE"
	fi
}

validate_staged_source() {
	local src="$1"
	[ -d "$src" ] || {
		write_state failed "Source component folder missing"
		return 1
	}
	[ -s "$src/gsp_agent.pl" ] || {
		write_state failed "Staged gsp_agent.pl missing or empty"
		return 1
	}
	if grep -Eqi '<html|not found|404' "$src/gsp_agent.pl"; then
		write_state failed "Staged gsp_agent.pl looks like an HTTP error page"
		return 1
	fi
	(cd "$src" && perl -c gsp_agent.pl >> "$UPDATE_LOG" 2>&1) || {
		write_state failed "Staged gsp_agent.pl failed syntax validation"
		return 1
	}
	[ ! -f "$src/gsp_agent_run" ] || bash -n "$src/gsp_agent_run" >> "$UPDATE_LOG" 2>&1 || {
		write_state failed "Staged gsp_agent_run failed syntax validation"
		return 1
	}
	validate_steamcmd_bootstrap "$src" || return 1
}

validate_steamcmd_bootstrap() {
	local root_dir="$1"
	local missing=""
	for file in \
		steamcmd/steamcmd.sh \
		steamcmd/linux32/steamcmd \
		steamcmd/linux32/steamerrorreporter \
		steamcmd/linux32/libstdc++.so.6 \
		steamcmd/linux32/crashhandler.so
	do
		[ -s "$root_dir/$file" ] || missing="$missing $file"
	done
	if [ -n "$missing" ]; then
		write_state failed "Staged SteamCMD bootstrap is incomplete:${missing}"
		return 1
	fi
	[ -x "$root_dir/steamcmd/steamcmd.sh" ] || {
		write_state failed "Staged SteamCMD bootstrap is not executable: steamcmd/steamcmd.sh"
		return 1
	}
	[ -x "$root_dir/steamcmd/linux32/steamcmd" ] || {
		write_state failed "Staged SteamCMD bootstrap is not executable: steamcmd/linux32/steamcmd"
		return 1
	}
}

restore_missing_steamcmd_bootstrap() {
	local src="$1"
	local file
	validate_steamcmd_bootstrap "$src" || return 1
	for file in \
		steamcmd/steamcmd.sh \
		steamcmd/linux32/steamcmd \
		steamcmd/linux32/steamerrorreporter \
		steamcmd/linux32/libstdc++.so.6 \
		steamcmd/linux32/crashhandler.so
	do
		if [ ! -e "$AGENTDIR/$file" ]; then
			mkdir -p "$(dirname "$AGENTDIR/$file")"
			cp -p "$src/$file" "$AGENTDIR/$file"
		fi
	done
	chmod +x "$AGENTDIR/steamcmd/steamcmd.sh" "$AGENTDIR/steamcmd/linux32/steamcmd" 2>/dev/null || true
}

backup_current_agent() {
	local tmp_archive
	tmp_archive="$(mktemp "${TMPDIR:-/tmp}/gsp-agent-restart-backup.XXXXXX.tar.gz")"
	tar \
		--exclude='./Cfg/Config.pm' \
		--exclude='./Cfg/Preferences.pm' \
		--exclude='./Cfg/bash_prefs.cfg' \
		--exclude='./ServerFiles' \
		--exclude='./Schedule' \
		--exclude='./logs' \
		--exclude='./screenlogs' \
		--exclude='./steamcmd' \
		--exclude='./startups' \
		--exclude='./runtime_status' \
		--exclude='./events' \
		--exclude='./tmp' \
		--exclude='./shared' \
		--exclude='./component_backups' \
		--exclude='./agent_self_update_backups' \
		--exclude='./agent_restart_update_backup.tar.gz' \
		--exclude='./gsp_agent_update_state.json' \
		--exclude='./gsp_agent_update_request.json' \
		--exclude='./gsp_agent_update.log' \
		--exclude='./*.pid' \
		-czf "$tmp_archive" -C "$AGENTDIR" . >> "$UPDATE_LOG" 2>&1 && mv "$tmp_archive" "$BACKUP_ARCHIVE"
}

copy_staged_source() {
	local src="$1"
	if command -v rsync >/dev/null 2>&1; then
		rsync -a \
			--exclude='.git/' \
			--exclude='Cfg/Config.pm' \
			--exclude='Cfg/Preferences.pm' \
			--exclude='Cfg/bash_prefs.cfg' \
			--exclude='ServerFiles/' \
			--exclude='Schedule/' \
			--exclude='logs/' \
			--exclude='screenlogs/' \
			--exclude='steamcmd/' \
			--exclude='startups/' \
			--exclude='runtime_status/' \
			--exclude='events/' \
			--exclude='tmp/' \
			--exclude='shared/' \
			--exclude='component_backups/' \
			--exclude='agent_self_update_backups/' \
			--exclude='agent_restart_update_backup.tar.gz' \
			--exclude='gsp_agent_update_state.json' \
			--exclude='gsp_agent_update_request.json' \
			--exclude='gsp_agent_update.log' \
			--exclude='*.pid' \
			"${src%/}/" "${AGENTDIR}/" >> "$UPDATE_LOG" 2>&1
	else
		(cd "$src" && tar \
			--exclude='./.git' \
			--exclude='./Cfg/Config.pm' \
			--exclude='./Cfg/Preferences.pm' \
			--exclude='./Cfg/bash_prefs.cfg' \
			--exclude='./ServerFiles' \
			--exclude='./Schedule' \
			--exclude='./logs' \
			--exclude='./screenlogs' \
			--exclude='./steamcmd' \
			--exclude='./startups' \
			--exclude='./runtime_status' \
			--exclude='./events' \
			--exclude='./tmp' \
			--exclude='./shared' \
			--exclude='./component_backups' \
			--exclude='./agent_self_update_backups' \
			--exclude='./agent_restart_update_backup.tar.gz' \
			--exclude='./gsp_agent_update_state.json' \
			--exclude='./gsp_agent_update_request.json' \
			--exclude='./gsp_agent_update.log' \
			--exclude='./*.pid' \
			-cf - .) | (cd "$AGENTDIR" && tar -xf -) >> "$UPDATE_LOG" 2>&1
	fi
	restore_missing_steamcmd_bootstrap "$src"
}

restore_backup() {
	[ -s "$BACKUP_ARCHIVE" ] || return 1
	tar -xzf "$BACKUP_ARCHIVE" -C "$AGENTDIR" >> "$UPDATE_LOG" 2>&1
}

auto_update_on_restart() {
	[ "${GSP_AGENT_SKIP_AUTO_UPDATE:-0}" = "1" ] && return 0
	[ -s "$REQUEST_FILE" ] || return 0
	if [ "$(read_pref agent_auto_update 0)" != "1" ]; then
		load_update_request || true
		write_state pending "Pending update request not applied because agent_auto_update is disabled" 0 "$(cat "$REVISION_FILE" 2>/dev/null || true)"
		return 0
	fi

	local repo branch source_path head current failed_key tmp_dir src changed_wrapper
	if ! load_update_request; then
		write_state failed "Pending update request is invalid" 0 "$(cat "$REVISION_FILE" 2>/dev/null || true)"
		clear_update_request
		return 0
	fi
	repo="$UPDATE_REPO"
	branch="$UPDATE_BRANCH"
	source_path="$UPDATE_SOURCE_PATH"
	[ -n "$repo" ] || {
		write_state failed "Restart-time update enabled but agent_update_repo_url is empty"
		clear_update_request
		return 0
	}
	[[ "$repo" =~ ^(https?://|ssh://|git@|/) && "$repo" != *$'\n'* && "$repo" != *$'\r'* ]] || {
		write_state failed "Invalid restart-time update repository URL"
		clear_update_request
		return 0
	}
	[[ "$branch" =~ ^[A-Za-z0-9._/-]{1,128}$ ]] || {
		write_state failed "Invalid restart-time update branch"
		clear_update_request
		return 0
	}
	[[ "$source_path" =~ ^[A-Za-z0-9._/-]+$ && "$source_path" != *".."* ]] || {
		write_state failed "Invalid restart-time update source path"
		clear_update_request
		return 0
	}

	command -v git >/dev/null 2>&1 || {
		write_state failed "git is required for restart-time update"
		clear_update_request
		return 0
	}

	head="$(git ls-remote --heads "$repo" "refs/heads/$branch" 2>>"$UPDATE_LOG" | awk '{print $1}' | head -n 1)"
	[ -n "$head" ] || {
		write_state failed "Could not resolve restart-time update branch"
		clear_update_request
		return 0
	}
	current="$(cat "$REVISION_FILE" 2>/dev/null || true)"
	UPDATE_VERSION_BEFORE="$current"
	if [ "$current" = "$head" ]; then
		write_state completed "Agent is already at the requested revision" 0 "$head"
		clear_update_request
		return 0
	fi

	failed_key="${repo}|${branch}|${head}"
	UPDATE_FAILED_KEY="$failed_key"
	if [ -f "$FAIL_MARKER" ] && grep -qxF "$failed_key" "$FAIL_MARKER"; then
		write_state failed "Skipping restart-time update after previous failure for this revision" 0 "$current"
		clear_update_request
		return 0
	fi

	tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/gsp-agent-restart-update.XXXXXX")"
	write_state running "Preparing restart-time update" 0 "$head"
	log_update "Restart-time queued update id=${UPDATE_ID} repo=${repo} branch=${branch} revision=${head}"

	if ! git clone --depth 1 --branch "$branch" "$repo" "$tmp_dir/repo" >> "$UPDATE_LOG" 2>&1; then
		printf '%s\n' "$failed_key" > "$FAIL_MARKER"
		write_state failed "git clone failed" 0 "$current"
		clear_update_request
		rm -rf "$tmp_dir"
		return 0
	fi

	src="$tmp_dir/repo/${source_path#./}"
	if ! validate_staged_source "$src"; then
		printf '%s\n' "$failed_key" > "$FAIL_MARKER"
		clear_update_request
		rm -rf "$tmp_dir"
		return 0
	fi

	if ! backup_current_agent; then
		printf '%s\n' "$failed_key" > "$FAIL_MARKER"
		write_state failed "Backup failed" 0 "$current"
		clear_update_request
		rm -rf "$tmp_dir"
		return 0
	fi
	ROLLBACK_AVAILABLE=1

	changed_wrapper=0
	if [ -f "$src/gsp_agent_run" ] && ! cmp -s "$src/gsp_agent_run" "$AGENTDIR/gsp_agent_run"; then
		changed_wrapper=1
	fi

	write_state running "Installing staged files" 0 "$head"
	if ! copy_staged_source "$src"; then
		printf '%s\n' "$failed_key" > "$FAIL_MARKER"
		if restore_backup; then
			write_state rolled_back "Copy failed; restored previous files" 1 "$current"
		else
			write_state failed "Copy failed and rollback restore failed" 1 "$current"
		fi
		clear_update_request
		rm -rf "$tmp_dir"
		return 0
	fi
	chmod +x "$AGENTDIR/gsp_agent_run" "$AGENTDIR/agent_conf.sh" "$AGENT" 2>/dev/null || true

	if ! (cd "$AGENTDIR" && perl -c gsp_agent.pl >> "$UPDATE_LOG" 2>&1); then
		printf '%s\n' "$failed_key" > "$FAIL_MARKER"
		if restore_backup; then
			write_state rolled_back "Updated agent failed post-copy syntax validation; restored previous files" 1 "$current"
		else
			write_state failed "Updated agent failed post-copy syntax validation and rollback restore failed" 1 "$current"
		fi
		clear_update_request
		rm -rf "$tmp_dir"
		return 0
	fi

	printf '%s\n' "$head" > "$REVISION_FILE"
	rm -f "$FAIL_MARKER"
	UPDATE_APPLIED=1
	UPDATE_APPLIED_AT="$(date +%s)"
	write_state completed "Restart-time update staged successfully" 0 "$head"
	clear_update_request
	rm -rf "$tmp_dir"

	if [ "$changed_wrapper" -eq 1 ]; then
		log "$(date): GSE agent wrapper changed during update; relaunching wrapper."
		GSP_AGENT_SKIP_AUTO_UPDATE=1 exec "$AGENTDIR/gsp_agent_run" -pidfile "$PID_FILE" "${agent_args[@]}"
	fi
}

rollback_after_start_failure() {
	[ "$UPDATE_APPLIED" -eq 1 ] || return 1
	[ "$ROLLBACK_AVAILABLE" -eq 1 ] || return 1
	if [ "$UPDATE_APPLIED_AT" -gt 0 ] && [ $(( $(date +%s) - UPDATE_APPLIED_AT )) -gt 120 ]; then
		return 1
	fi
	log_update "Updated agent exited before a clean start; attempting rollback."
	[ -n "$UPDATE_FAILED_KEY" ] && printf '%s\n' "$UPDATE_FAILED_KEY" > "$FAIL_MARKER"
	if restore_backup; then
		write_state rolled_back "Updated agent exited during startup; restored previous files" 1 "$(cat "$REVISION_FILE" 2>/dev/null || true)"
		GSP_AGENT_SKIP_AUTO_UPDATE=1 exec "$AGENTDIR/gsp_agent_run" -pidfile "$PID_FILE" "${agent_args[@]}"
	fi
	write_state failed "Updated agent exited during startup and rollback restore failed" 1 "$(cat "$REVISION_FILE" 2>/dev/null || true)"
	return 1
}

parse_args "$@"
prepare_runtime
validate_config
acquire_instance_lock

LISTEN_IP="$(config_value listen_ip)"
LISTEN_PORT="$(config_value listen_port)"
ensure_port_available "$LISTEN_IP" "$LISTEN_PORT"

if [ ! -x "$AGENT" ]; then
	chmod ug+x "$AGENT" 2>/dev/null || true
fi

echo "$$" > "$PID_FILE"
trap cleanup_pid EXIT INT TERM

cd "$AGENTDIR"
auto_update_on_restart

while true; do
	perl "$AGENT" "${agent_args[@]}" || rc=$?
	rc="${rc:-0}"
	if [ "$rc" -eq 0 ]; then
		log "$(date): GSE Agent stopped cleanly"
		exit 0
	fi
	rollback_after_start_failure || true
	log "$(date): GSE Agent exited with status ${rc}; restarting in ${TIMEOUT}s" >&2
	sleep "$TIMEOUT"
	unset rc
done
